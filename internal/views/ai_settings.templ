package views

import (
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	switchcomp "github.com/cristianadrielbraun/gofer/components/switch"
)

type AISettingsData struct {
	AnalysisEnabled        bool
	DraftingEnabled        bool
	AutoSpamEnabled        bool
	AutoUnsubscribeEnabled bool
	WorkerReady            bool
	DraftingReady          bool
}

templ AISettingsTab(data AISettingsData) {
	<div class="mt-6 space-y-6">
		<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
			<div>
				<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">{ i18n.T(ctx, "ai.settings.heading") }</h3>
				<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "ai.settings.intro") }</p>
			</div>
			<form data-ai-settings-form class="space-y-4" novalidate>
				<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
					<div class="min-w-0">
						<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "ai.settings.analyze.heading") }</h4>
						<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "ai.settings.analyze.description") }</p>
						if !data.WorkerReady {
							<p class="text-xs text-amber-800 dark:text-amber-300 mt-1">{ i18n.T(ctx, "ai.settings.analyze.unconfigured") }</p>
						}
					</div>
					<div class="w-full sm:w-44 shrink-0">
						@settingsSwitchBox(i18n.T(ctx, "ai.settings.enabled")) {
							@switchcomp.Switch(switchcomp.Props{
								ID:       "ai-analysis-enabled",
								Name:     "analysis_enabled",
								Checked:  data.AnalysisEnabled,
								Disabled: !data.WorkerReady && !data.AnalysisEnabled,
								Attributes: templ.Attributes{"data-ai-setting": "analysis_enabled"},
							})
						}
					</div>
				</div>
				<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
					<div class="min-w-0">
						<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "ai.settings.draft.heading") }</h4>
						<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "ai.settings.draft.description") }</p>
						if !data.DraftingReady {
							<p class="text-xs text-amber-800 dark:text-amber-300 mt-1">{ i18n.T(ctx, "ai.settings.draft.unconfigured") }</p>
						}
					</div>
					<div class="w-full sm:w-44 shrink-0">
						@settingsSwitchBox(i18n.T(ctx, "ai.settings.enabled")) {
							@switchcomp.Switch(switchcomp.Props{
								ID:         "ai-drafting-enabled",
								Name:       "drafting_enabled",
								Checked:    data.DraftingEnabled,
								Disabled:   !data.DraftingReady && !data.DraftingEnabled,
								Attributes: templ.Attributes{"data-ai-setting": "drafting_enabled"},
							})
						}
					</div>
				</div>
				<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
					<div class="min-w-0">
						<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "ai.settings.spam.heading") }</h4>
						<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "ai.settings.spam.description") }</p>
					</div>
					<div class="w-full sm:w-44 shrink-0">
						@settingsSwitchBox(i18n.T(ctx, "ai.settings.enabled")) {
							@switchcomp.Switch(switchcomp.Props{
								ID:         "ai-auto-spam-enabled",
								Name:       "auto_spam_enabled",
								Checked:    data.AutoSpamEnabled,
								Attributes: templ.Attributes{"data-ai-setting": "auto_spam_enabled"},
							})
						}
					</div>
				</div>
				<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
					<div class="min-w-0">
						<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "ai.settings.unsubscribe.heading") }</h4>
						<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "ai.settings.unsubscribe.description") }</p>
					</div>
					<div class="w-full sm:w-44 shrink-0">
						@settingsSwitchBox(i18n.T(ctx, "ai.settings.enabled")) {
							@switchcomp.Switch(switchcomp.Props{
								ID:         "ai-auto-unsubscribe-enabled",
								Name:       "auto_unsubscribe_enabled",
								Checked:    data.AutoUnsubscribeEnabled,
								Attributes: templ.Attributes{"data-ai-setting": "auto_unsubscribe_enabled"},
							})
						}
					</div>
				</div>
				<div class="flex items-center justify-between gap-3 border-t border-border/60 pt-5">
					<p class="text-xs text-muted-foreground" data-ai-settings-status>{ i18n.T(ctx, "ai.settings.audited") }</p>
					<button type="submit" class="inline-flex items-center rounded-md bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground hover:bg-primary/90 disabled:opacity-50" data-ai-settings-save>{ i18n.T(ctx, "ai.settings.save") }</button>
				</div>
			</form>
		</div>
		<div class="settings-card bg-card rounded-lg border p-6">
			<div class="flex flex-wrap items-start justify-between gap-3">
				<div>
					<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">{ i18n.T(ctx, "ai.settings.projects.heading") }</h3>
					<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "ai.settings.projects.intro") }</p>
				</div>
				<button type="button" class="rounded-md border border-border px-3 py-1.5 text-xs font-medium hover:bg-muted" data-ai-projects-seed>{ i18n.T(ctx, "ai.settings.projects.create_defaults") }</button>
			</div>
			<div class="mt-4 divide-y divide-border/60" data-ai-projects>
				<p class="py-3 text-xs text-muted-foreground">{ i18n.T(ctx, "ai.settings.projects.loading") }</p>
			</div>
			<p class="mt-3 text-xs text-muted-foreground" data-ai-projects-status></p>
		</div>
		<div class="settings-card bg-card rounded-lg border p-6">
			<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-2">{ i18n.T(ctx, "ai.settings.routing.heading") }</h3>
			<p class="text-xs text-muted-foreground mb-4">{ i18n.T(ctx, "ai.settings.routing.intro") }</p>
			<form class="grid gap-3 sm:grid-cols-2" data-ai-connector-form>
				<label class="text-xs font-medium">{ i18n.T(ctx, "ai.settings.name") }
					<input name="name" required maxlength="80" class="mt-1 w-full rounded-md border border-border bg-background px-2 py-1.5 text-sm" placeholder={ i18n.T(ctx, "ai.settings.connector_placeholder") }>
				</label>
				<label class="text-xs font-medium">{ i18n.T(ctx, "ai.settings.url") }
					<input name="url" required type="url" class="mt-1 w-full rounded-md border border-border bg-background px-2 py-1.5 text-sm" placeholder={ i18n.T(ctx, "ai.settings.url_placeholder") }>
				</label>
				<label class="text-xs font-medium">{ i18n.T(ctx, "ai.settings.secret") }
					<input name="secret" required type="password" autocomplete="new-password" class="mt-1 w-full rounded-md border border-border bg-background px-2 py-1.5 text-sm">
				</label>
				<div class="flex items-end gap-3">
					<label class="flex items-center gap-2 text-xs">
						<input name="allow_private" type="checkbox" class="h-4 w-4 rounded border-border">
						{ i18n.T(ctx, "ai.settings.allow_private") }
					</label>
					<button type="submit" class="rounded-md bg-primary px-3 py-1.5 text-xs font-medium text-primary-foreground">{ i18n.T(ctx, "ai.settings.add_connector") }</button>
				</div>
			</form>
			<div class="mt-4 divide-y divide-border/60" data-ai-connectors>
				<p class="py-3 text-xs text-muted-foreground">{ i18n.T(ctx, "ai.settings.loading_connectors") }</p>
			</div>
			<p class="mt-3 text-xs text-muted-foreground" data-ai-connectors-status></p>
			<div class="mt-5 border-t border-border/60 pt-4">
				<h4 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "ai.settings.recent_automation") }</h4>
				<div class="mt-2 divide-y divide-border/60" data-ai-deliveries>
					<p class="py-3 text-xs text-muted-foreground">{ i18n.T(ctx, "ai.settings.loading_activity") }</p>
				</div>
			</div>
		</div>
		<div class="settings-card bg-card rounded-lg border p-6">
			<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-2">{ i18n.T(ctx, "ai.settings.api.heading") }</h3>
			<p class="text-xs text-muted-foreground mb-4">{ i18n.T(ctx, "ai.settings.api.intro") }</p>
			<form class="grid gap-3 sm:grid-cols-2" data-ai-token-form>
				<label class="text-xs font-medium">{ i18n.T(ctx, "ai.settings.name") }
					<input name="name" required maxlength="80" class="mt-1 w-full rounded-md border border-border bg-background px-2 py-1.5 text-sm" placeholder={ i18n.T(ctx, "ai.settings.token_placeholder") }>
				</label>
				<label class="text-xs font-medium">{ i18n.T(ctx, "ai.settings.expires") }
					<select name="expires_in_days" class="mt-1 w-full rounded-md border border-border bg-background px-2 py-1.5 text-sm">
						<option value="30">{ i18n.T(ctx, "ai.settings.expires.days_30") }</option>
						<option value="90" selected>{ i18n.T(ctx, "ai.settings.expires.days_90") }</option>
						<option value="365">{ i18n.T(ctx, "ai.settings.expires.year_1") }</option>
					</select>
				</label>
				<div class="flex flex-wrap items-center gap-4 sm:col-span-2">
					<label class="flex items-center gap-2 text-xs"><input type="checkbox" name="scope_read" checked class="h-4 w-4 rounded border-border">{ i18n.T(ctx, "ai.settings.scope_read") }</label>
					<label class="flex items-center gap-2 text-xs"><input type="checkbox" name="scope_draft" class="h-4 w-4 rounded border-border">{ i18n.T(ctx, "ai.settings.scope_draft") }</label>
					<label class="flex items-center gap-2 text-xs"><input type="checkbox" name="scope_write" class="h-4 w-4 rounded border-border">{ i18n.T(ctx, "ai.settings.scope_write") }</label>
					<button type="submit" class="ml-auto rounded-md bg-primary px-3 py-1.5 text-xs font-medium text-primary-foreground">{ i18n.T(ctx, "ai.settings.generate_token") }</button>
				</div>
			</form>
			<div class="mt-4 hidden rounded-md border border-amber-300 bg-amber-50 p-3 text-xs dark:border-amber-700 dark:bg-amber-950" data-ai-token-result>
				<p class="font-medium">{ i18n.T(ctx, "ai.settings.token_warning") }</p>
				<code class="mt-2 block break-all rounded bg-background p-2" data-ai-token-secret></code>
			</div>
			<div class="mt-4 divide-y divide-border/60" data-ai-tokens>
				<p class="py-3 text-xs text-muted-foreground">{ i18n.T(ctx, "ai.settings.loading_tokens") }</p>
			</div>
			<p class="mt-3 text-xs text-muted-foreground" data-ai-tokens-status></p>
		</div>
		<div class="settings-card bg-card rounded-lg border p-6">
			<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-2">{ i18n.T(ctx, "ai.settings.legitimacy.heading") }</h3>
			<p class="text-xs text-muted-foreground mb-4">{ i18n.T(ctx, "ai.settings.legitimacy.intro") }</p>
			<div class="divide-y divide-border/60" data-ai-legitimacy>
				<p class="py-3 text-xs text-muted-foreground">{ i18n.T(ctx, "ai.settings.legitimacy.loading") }</p>
			</div>
			<p class="mt-3 text-xs text-muted-foreground" data-ai-legitimacy-status></p>
		</div>
		<div class="settings-card bg-card rounded-lg border p-6">
			<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-2">{ i18n.T(ctx, "ai.settings.safety.heading") }</h3>
			<ul class="list-disc pl-5 text-xs leading-relaxed text-muted-foreground space-y-1">
				<li>{ i18n.T(ctx, "ai.settings.safety.phishing") }</li>
				<li>{ i18n.T(ctx, "ai.settings.safety.unsure") }</li>
				<li>{ i18n.T(ctx, "ai.settings.safety.trust") }</li>
				<li>{ i18n.T(ctx, "ai.settings.safety.audit") }</li>
			</ul>
		</div>
	</div>
}
