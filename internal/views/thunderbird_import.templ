package views

import (
	"strings"

	"github.com/cristianadrielbraun/gofer/components/checkbox"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"github.com/cristianadrielbraun/gofer/internal/providers"
)

type ThunderbirdImportAccount struct {
	Ref      string
	Email    string
	Name     string
	Provider string
	Host     string
	Status   string
	Needs    []string
	Warning  string
}

type ThunderbirdImportPreviewData struct {
	Prefs      string
	Accounts   []ThunderbirdImportAccount
	Warnings   []string
	Signatures int
}

type ThunderbirdImportResultData struct {
	Added      []string
	Failed     []string
	Skipped    int
	Signatures int
}

templ ThunderbirdImportUploadForm(locale i18n.Locale, message string) {
	@dataDialogScroll("pb-6") {
		<form
			hx-post="/api/thunderbird/import/preview"
			hx-encoding="multipart/form-data"
			hx-target="#thunderbird-import-panel"
			hx-swap="innerHTML"
			class="space-y-2"
		>
			<label for="thunderbird-import-file" class="block text-sm font-medium text-foreground">{ i18n.L(locale, "thunderbird.upload.label") }</label>
			<div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
				<input id="thunderbird-import-file" type="file" name="thunderbird" accept=".js,.txt,.zip" required class="block h-8 w-full min-w-0 flex-1 rounded-md border border-input bg-background p-[3px] text-xs text-foreground file:mr-3 file:h-full file:cursor-pointer file:rounded file:border-0 file:bg-primary file:px-3 file:text-xs file:font-medium file:text-primary-foreground hover:file:bg-primary/90"/>
				<button type="submit" class={ profileButtonClass }>
					@icon.Upload(icon.Props{Class: "size-3.5"})
					{ i18n.L(locale, "thunderbird.upload.review") }
				</button>
			</div>
			<p class="text-xs leading-relaxed text-muted-foreground">
				{ i18n.L(locale, "thunderbird.upload.help") }
			</p>
			if message != "" {
				<p class="text-xs text-destructive" role="alert" data-thunderbird-import-error>{ message }</p>
			}
		</form>
	}
}

func thunderbirdStatusLabel(locale i18n.Locale, status string) string {
	switch status {
	case "exists":
		return i18n.L(locale, "thunderbird.status.exists")
	case "unsupported":
		return i18n.L(locale, "thunderbird.status.unsupported")
	default:
		return i18n.L(locale, "thunderbird.status.ready")
	}
}

func thunderbirdStatusDescription(locale i18n.Locale, account ThunderbirdImportAccount) string {
	switch account.Status {
	case "exists":
		return i18n.L(locale, "thunderbird.status.exists_description")
	case "unsupported":
		return i18n.L(locale, "thunderbird.status.unsupported_description")
	}
	if account.Provider == providers.ProviderGmail || account.Provider == providers.ProviderOutlook {
		return i18n.L(locale, "thunderbird.status.ready_oauth_description")
	}
	return i18n.L(locale, "thunderbird.status.ready_description")
}

func thunderbirdJoin(locale i18n.Locale, items []string) string {
	switch len(items) {
	case 0:
		return ""
	case 1:
		return items[0]
	case 2:
		return items[0] + i18n.L(locale, "list.and") + items[1]
	default:
		return strings.Join(items[:len(items)-1], ", ") + i18n.L(locale, "list.and_serial") + items[len(items)-1]
	}
}

func thunderbirdFailureMessage(locale i18n.Locale, emails []string) string {
	key := "thunderbird.result.failed_other"
	if len(emails) == 1 {
		key = "thunderbird.result.failed_one"
	}
	return i18n.Lf(locale, key, thunderbirdJoin(locale, emails))
}

func thunderbirdAccountLabel(account ThunderbirdImportAccount) string {
	if account.Name != "" {
		return account.Name
	}
	return account.Email
}

templ ThunderbirdImportPreview(locale i18n.Locale, data ThunderbirdImportPreviewData) {
	<form
		hx-post="/api/thunderbird/import"
		hx-target="#thunderbird-import-panel"
		hx-swap="innerHTML"
		class={ dataDialogFormClass }
		data-thunderbird-preview
	>
		@dataDialogScroll("space-y-5 pb-4") {
			<textarea name="prefs" hidden>{ data.Prefs }</textarea>
			if len(data.Warnings) > 0 {
				<div class="space-y-1 rounded-lg border border-amber-500/30 bg-amber-500/5 p-3 text-xs text-amber-800 dark:text-amber-300" data-thunderbird-warnings>
					for _, warning := range data.Warnings {
						<p>{ warning }</p>
					}
				</div>
			}
			if len(data.Accounts) == 0 {
				<p class="text-sm text-muted-foreground">{ i18n.L(locale, "thunderbird.preview.empty") }</p>
			} else {
				<div class="space-y-2">
					<p class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.L(locale, "thunderbird.preview.accounts") }</p>
					for _, account := range data.Accounts {
						<div class={ "flex flex-wrap items-start gap-3 rounded-lg border border-border/60 bg-background/40 p-3", templ.KV("opacity-60", account.Status != "new") } data-thunderbird-account={ account.Email }>
							<label class="flex min-w-0 flex-1 items-start gap-3">
								@checkbox.Checkbox(checkbox.Props{Name: "account", Value: account.Ref, Checked: account.Status == "new", Disabled: account.Status != "new"})
								<span class="min-w-0 flex-1">
									<span class="flex min-w-0 items-center gap-2">
										<span class="truncate text-sm font-medium text-foreground">{ thunderbirdAccountLabel(account) }</span>
										<span class="inline-flex shrink-0 items-center gap-1 rounded-md border border-border/70 bg-muted/35 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-muted-foreground">
											@AccountProviderIcon(account.Provider, "size-3 shrink-0")
											{ accountProviderName(account.Provider) }
										</span>
									</span>
									if account.Name != "" && account.Email != "" && account.Name != account.Email {
										<span class="block truncate text-xs text-muted-foreground">{ account.Email }</span>
									}
									if account.Host != "" {
										<span class="mt-0.5 block truncate text-xs text-muted-foreground">{ account.Host }</span>
									}
									<span class="mt-1 block text-xs text-muted-foreground">
										<span class="font-medium">{ thunderbirdStatusLabel(locale, account.Status) }.</span>
										{ thunderbirdStatusDescription(locale, account) }
									</span>
									if account.Warning != "" {
										<span class="mt-1 block text-xs text-amber-700 dark:text-amber-400">{ account.Warning }</span>
									}
								</span>
							</label>
						</div>
					}
				</div>
			}
			if data.Signatures > 0 {
				<div class="space-y-2">
					<p class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.L(locale, "thunderbird.preview.signatures") }</p>
					@profileImportSection("signatures", i18n.LTP(locale, data.Signatures, "thunderbird.count.signature_one", "thunderbird.count.signature_other", data.Signatures), i18n.L(locale, "thunderbird.preview.signatures_description"), true)
				</div>
			}
		}
		@dataDialogFooter() {
			<button type="button" class={ profileButtonClass } hx-get="/api/thunderbird/import/upload" hx-target="#thunderbird-import-panel" hx-swap="innerHTML">
				{ i18n.L(locale, "thunderbird.action.cancel") }
			</button>
			<button type="submit" class={ profilePrimaryButtonClass } data-thunderbird-import-submit>
				@icon.Upload(icon.Props{Class: "size-3.5"})
				{ i18n.L(locale, "thunderbird.action.import") }
			</button>
		}
	</form>
}

templ ThunderbirdImportResult(locale i18n.Locale, result ThunderbirdImportResultData) {
	<div class={ dataDialogFormClass } data-thunderbird-result>
		@dataDialogScroll("space-y-4 pb-4") {
			<div class="flex items-start gap-2.5">
				@icon.CircleCheck(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-emerald-600 dark:text-emerald-400"})
				<div class="min-w-0 space-y-1 text-sm text-foreground">
					<p class="font-medium">{ i18n.L(locale, "thunderbird.result.title") }</p>
					<ul class="space-y-0.5 text-xs text-muted-foreground">
						if len(result.Added) > 0 {
							<li>{ i18n.LTP(locale, len(result.Added), "thunderbird.result.added_one", "thunderbird.result.added_other", len(result.Added), thunderbirdJoin(locale, result.Added)) }</li>
						}
						if result.Signatures > 0 {
							<li>{ i18n.LTP(locale, result.Signatures, "thunderbird.result.signature_one", "thunderbird.result.signature_other", result.Signatures) }</li>
						}
						if result.Skipped > 0 {
							<li>{ i18n.LTP(locale, result.Skipped, "thunderbird.result.skipped_one", "thunderbird.result.skipped_other", result.Skipped) }</li>
						}
						if len(result.Added) == 0 && len(result.Failed) == 0 && result.Skipped == 0 {
							<li>{ i18n.L(locale, "thunderbird.result.none_selected") }</li>
						}
					</ul>
					if len(result.Added) > 0 {
						<p class="text-xs text-muted-foreground">{ i18n.L(locale, "thunderbird.result.no_passwords") }</p>
					}
				</div>
			</div>
			if len(result.Failed) > 0 {
				<div class="flex items-start gap-2.5 rounded-lg border border-destructive/30 bg-destructive/5 p-3 text-xs text-destructive" role="alert">
					@icon.TriangleAlert(icon.Props{Class: "mt-0.5 size-3.5 shrink-0"})
					<p>{ thunderbirdFailureMessage(locale, result.Failed) }</p>
				</div>
			}
		}
		@dataDialogFooter() {
			<button type="button" class={ profileButtonClass } hx-get="/api/thunderbird/import/upload" hx-target="#thunderbird-import-panel" hx-swap="innerHTML">
				{ i18n.L(locale, "thunderbird.action.import_another") }
			</button>
			if len(result.Added) > 0 {
				<a href="/settings/accounts" class={ profilePrimaryButtonClass }>{ i18n.L(locale, "thunderbird.action.accounts") }</a>
			}
		}
	</div>
}
