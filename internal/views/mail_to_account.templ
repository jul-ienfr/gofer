package views

import (
	"strings"

	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/radio"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
)

// MailToAccountDialogData describes emails about to go into a folder of
// another account. Problem, when set, says why they can't. ToLocal says the
// folder is in Local folders, where moving them is mostly to free space on
// the server, so deleting them there for good is offered first.
type MailToAccountDialogData struct {
	Count   int
	Sources []string
	Target  string
	Folder  string
	Problem string
	ToLocal bool
}

// MailToAccountDialog asks before emails go into another account, and
// whether they then leave the account they're in.
templ MailToAccountDialog(locale i18n.Locale, data MailToAccountDialogData) {
	{{ mode := mailToAccountDefaultMode(data) }}
	@dialog.Dialog(dialog.Props{ID: "mail-to-account-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-lg", Attributes: templ.Attributes{"data-mail-to-account-dialog": ""}}) {
			@dialog.Header() {
				@dialog.Title() {
					if data.Problem != "" {
						{ i18n.T(locale, "mail.to_account.problem_title") }
					} else {
						{ i18n.T(locale, "mail.to_account.title") }
					}
				}
			}
			if data.Problem != "" {
				<p class="min-w-0 text-sm text-muted-foreground [overflow-wrap:anywhere]" data-mail-to-account-problem>{ data.Problem }</p>
			} else {
				<div class="min-w-0 space-y-3 text-sm text-foreground [overflow-wrap:anywhere]">
					<div class="flex items-start gap-2.5 rounded-md border border-amber-500/40 bg-amber-500/10 p-3">
						@icon.TriangleAlert(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-amber-600 dark:text-amber-400"})
						<p>
							{ mailToAccountSummary(locale, data) }
						</p>
					</div>
					<div class="space-y-2" role="radiogroup" aria-label={ i18n.T(locale, "mail.to_account.mode_group") } data-mail-to-account-modes>
						@mailToAccountMode(locale, "move", i18n.T(locale, "mail.to_account.move"), i18n.Tf(locale, "mail.to_account.move_desc", data.Target, mailToAccountSources(locale, data.Sources)), mode)
						@mailToAccountMode(locale, "move-delete", i18n.T(locale, "mail.to_account.move_delete"), i18n.Tf(locale, "mail.to_account.move_delete_desc", data.Target, mailToAccountSources(locale, data.Sources)), mode)
						@mailToAccountMode(locale, "copy", i18n.T(locale, "mail.to_account.copy"), i18n.Tf(locale, "mail.to_account.copy_desc", mailToAccountSources(locale, data.Sources), data.Target), mode)
					</div>
					<p class="text-xs text-muted-foreground">{ i18n.T(locale, "mail.to_account.background") }</p>
				</div>
			}
			@dialog.Footer() {
				@dialog.Close() {
					@button.Button(button.Props{Variant: button.VariantOutline, Class: "h-8 px-3 text-xs"}) {
						{ i18n.T(locale, "mail.action.cancel") }
					}
				}
				if data.Problem == "" {
					@button.Button(button.Props{
						Class:      "h-8 px-3 text-xs",
						Attributes: templ.Attributes{"data-mail-to-account-confirm": "", "data-on-click": onAction("confirmMessagesToAccount")},
					}) {
						{ mailToAccountModeButton(locale, mode) }
					}
				}
			}
		}
	}
}

templ mailToAccountMode(locale i18n.Locale, value, label, detail, selected string) {
	<label class="flex items-start gap-2.5 text-sm text-foreground">
		<span class="mt-0.5 flex shrink-0">
			@radio.Radio(radio.Props{
				Name:       "mail-to-account-mode",
				Value:      value,
				Checked:    value == selected,
				Attributes: templ.Attributes{"data-mail-to-account-mode": value, "data-mail-to-account-button": mailToAccountModeButton(locale, value), "data-on-change": onAction("chooseMessagesToAccountMode", actionElement)},
			})
		</span>
		<span>
			<span class="font-medium">{ label }</span>
			<span class="block text-xs text-muted-foreground mt-0.5">{ detail }</span>
		</span>
	</label>
}

// mailToAccountDefaultMode is the choice the dialog opens with: a plain move,
// or for Local folders a move that deletes the emails for good.
func mailToAccountDefaultMode(data MailToAccountDialogData) string {
	if data.ToLocal {
		return "move-delete"
	}
	return "move"
}

// mailToAccountModeButton is the confirm button's label for a choice.
func mailToAccountModeButton(locale i18n.Locale, mode string) string {
	switch mode {
	case "move-delete":
		return i18n.T(locale, "mail.to_account.button_move_delete")
	case "copy":
		return i18n.T(locale, "mail.to_account.button_copy")
	}
	return i18n.T(locale, "mail.to_account.button_move")
}

func mailToAccountSources(locale i18n.Locale, sources []string) string {
	return strings.Join(sources, " "+i18n.T(locale, "mail.to_account.and")+" ")
}

func mailToAccountSummary(locale i18n.Locale, data MailToAccountDialogData) string {
	sources := mailToAccountSources(locale, data.Sources)
	switch {
	case data.Count <= 0:
		return i18n.Tf(locale, "mail.to_account.summary_none", sources, data.Folder, data.Target)
	case data.Count == 1:
		return i18n.Tf(locale, "mail.to_account.summary_one", sources, data.Folder, data.Target)
	default:
		return i18n.Tf(locale, "mail.to_account.summary_many", mailLocaleCount(locale, data.Count, "mail.count.message_one", "mail.count.message_other"), sources, data.Folder, data.Target)
	}
}
